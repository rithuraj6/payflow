pipeline {
    agent any

    parameters {
        string(
            name: 'IMAGE_TAG',
            description: 'Docker image tag produced by PayFlow-CI'
        )
    }

    stages {

        stage('Checkout GitOps') {
            steps {
                checkout scm
            }
        }
        stage('Update Helm Image') {
            steps {
                sh '''
                    sed -i \
                    "s|tag: .*|tag: \\"${IMAGE_TAG}\\"|" \
                    helm/payflow/values.yaml

                    echo "Updated Helm image:"
                    grep -A3 '^image:' helm/payflow/values.yaml
                '''
            }
        }

        stage('Show Image') {
            steps {
                echo "Deploying image:"
                echo "rithuraj6/payflow-api:${params.IMAGE_TAG}"
            }
        }

       stage('Commit and Push GitOps') {
            steps {
                sshagent(credentials: ['github-ssh']) {
                    sh '''
                        git config user.name "Jenkins"
                        git config user.email "jenkins@payflow.local"

                        git add helm/payflow/values.yaml

                        git commit -m "chore: deploy payflow image ${IMAGE_TAG}" || true

                        git remote set-url origin git@github.com:rithuraj6/payflow.git

                        git push origin HEAD:gitops
                    '''
                }
            }
        }
    }
}