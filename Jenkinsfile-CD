pipeline {
    agent any

    parameters {
        string(
            name: 'IMAGE_TAG',
            description: 'Docker image tag produced by PayFlow-CI'
        )
    }

    stages {

        stage('Checkout GitOps') {
            steps {
                checkout scm
            }
        }

                stage('Show Image') {
            steps {
                echo "Deploying image:"
                echo "rithuraj6/payflow-api:${params.IMAGE_TAG}"
            }
        }

       stage('Commit and Push GitOps') {
            steps {
                sh '''
                    git config user.name "Jenkins"
                    git config user.email "jenkins@payflow.local"

                    git add helm/payflow/values.yaml

                    git commit -m "chore: deploy payflow image ${IMAGE_TAG}" || true

                    git push origin gitops
                '''
            }
        }
    }
}